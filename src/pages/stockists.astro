---
import { getImage } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import mapSrc from "../assets/stockists/map.png";

const map = await getImage({ src: mapSrc });
---

<Layout title="stockists">
  <div
    class="h-dvh bg-contain bg-center bg-no-repeat"
    style={`background-image: url(${map.src})`}
  >
  </div>
</Layout>
