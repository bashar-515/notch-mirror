---

<Layout title="stockists">
  <div class="py-frame relative">
    <Image src={map} alt="Map of Notch stockists" class="h-auto w-[82%]" />

    <div class="absolute inset-0 flex">
      <div class="w-1/2 shrink-0"></div>

      <div
        class="pt-frame mx-24 flex flex-1 flex-col items-center self-start border-b-2 border-black"
      >
        {
          Object.entries(stockistsByLocation).map(([location, stockists]) => (
            <details name="stockist" class="w-full">
              <summary class="font-times relative flex list-none items-center justify-center border-t-2 border-black py-4 text-3xl [&::-webkit-details-marker]:hidden">
                {location}
                <span class="absolute right-4">›</span>
              </summary>
              {stockists.map((stockist) => (
                <div>
                  <p>{stockist.name}</p>
                  <p>{stockist.address}</p>
                  <p>{stockist.place}</p>
                </div>
              ))}
            </details>
          ))
        }
      </div>
    </div>
  </div>
</Layout>
