---
import Instagram from "../components/icons/Instagram.astro";
import Logo from "../components/icons/Logo.astro";
import X from "../components/icons/X.astro";
import "../styles/global.css";

type Link = { href: string; label: string };

const navLinks: Link[] = [
  { href: "/issues", label: "ISSUES" },
  { href: "/events", label: "EVENTS" },
  { href: "/", label: "NOTCH MAGAZINE" },
  { href: "/stockists", label: "STOCKISTS" },
  { href: "/shop", label: "SHOP" },
];

const footerLinksByColumn: Link[][] = [
  [
    { href: "/about", label: "About" },
    { href: "/events", label: "Events" },
  ],
  [
    { href: "/issues", label: "Issues" },
    { href: "/stockists", label: "Stockists" },
  ],
  [
    { href: "/donate", label: "Support" },
    { href: "/shop", label: "Subscribe" },
  ],
  [
    { href: "/shop", label: "Shop" },
    { href: "/submissions", label: "Submit" },
  ],
];

const isHome = Astro.url.pathname === "/";
---

<html lang="en" class="overscroll-none">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.png" />

    <link
      rel="preload"
      href="/fonts/Gravity/Gravity/ABCGravity-Compressed.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <title>Notch Magazine</title>
  </head>

  <body class="bg-secondary">
    <nav
      data-home={isHome}
      class:list={[
        "text-primary fixed inset-x-0 top-0 z-1 flex items-center justify-between px-27 py-3",
        isHome && "bg-secondary pointer-events-none opacity-0",
      ]}
    >
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class={
              link.href === "/"
                ? "font-sans text-6xl"
                : `font-sans text-3xl ${Astro.url.pathname === link.href ? "" : "decoration-1 underline-offset-4 hover:underline"}`
            }
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <main class="min-h-dvh">
      <slot />
    </main>

    <footer
      class="bg-tertiary font-times grid grid-cols-3 items-center px-24 py-6"
    >
      <div class="flex">
        <a href="/"
          ><Logo
            class="hover:text-secondary h-32 w-auto text-white transition-colors duration-200"
          /></a
        >

        <div class="ml-auto flex gap-4 self-center">
          {
            footerLinksByColumn.map((column) => (
              <div class="flex flex-col gap-2">
                {column.map((link) => (
                  <a
                    href={link.href}
                    class="text-primary hover:text-secondary text-lg font-bold"
                  >
                    {link.label}
                  </a>
                ))}
              </div>
            ))
          }
        </div>
      </div>

      <div class="text-center">
        <div class="m-8 flex justify-center gap-6">
          <a
            href="https://www.instagram.com/notch.magazine/"
            rel="noopener noreferrer"
            class="hover:text-secondary font-bold text-white transition-colors duration-200"
            ><Instagram class="h-7 w-auto" /></a
          >
          <a
            href="https://x.com/notch_magazine"
            rel="noopener noreferrer"
            class="hover:text-secondary text-white transition-colors duration-200"
            ><X class="h-7 w-auto" /></a
          >
        </div>

        <p class="text-lg">
          © <span class="italic">2026, Notch Magazine, LLC</span>
        </p>
      </div>

      <div class="flex flex-col gap-1 justify-self-end">
        <p class="px-2 text-lg italic">Sign up to recieve news and updates</p>

        <input
          type="email"
          placeholder="Email"
          class="border-secondary rounded-sm border px-6 py-1 focus:outline-none"
        />
        <button
          type="button"
          class="hover:bg-secondary text-primary rounded-sm bg-white py-1 transition-colors duration-200"
          >Sign up</button
        >
      </div>
    </footer>
  </body>
</html>

<script>
  const nav = document.querySelector("nav");

  if (nav?.dataset.home === "true") {
    const update = () => {
      const start = (100 / 100) * window.innerHeight;
      const end = (125 / 100) * window.innerHeight - nav!.offsetHeight;

      const opacity = Math.min(
        1,
        Math.max(0, (window.scrollY - start) / (end - start)),
      );

      nav.style.opacity = String(opacity);
      nav.style.pointerEvents = opacity < 0.05 ? "none" : "auto";
    };

    update();

    window.addEventListener("scroll", update, { passive: true });
  } else if (nav) {
    const progress = (px: number) => {
      const l = Math.min(1, Math.max(0, window.scrollY / px));
      return l < 0.5 ? 2 * l * l : 2 * l * (2 - l) - 1;
    };

    const update = () => {
      const fade = 1 - progress(50);

      for (const link of nav.querySelectorAll("a")) {
        if (link.getAttribute("href") === "/") {
          link.style.transform = `scale(${1 - 0.2 * progress(300)})`;
        } else {
          link.style.opacity = String(fade);
          link.style.visibility = fade ? "visible" : "hidden";
        }
      }
    };

    update();

    window.addEventListener("scroll", update, { passive: true });
  }
</script>
