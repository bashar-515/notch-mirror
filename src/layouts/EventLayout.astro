---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import Layout from "./Layout.astro";

const images = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/events/*/{top,bottom}/*.{jpg,png}",
  { eager: true },
);

type Props = {
  title: string;
  name: string;
  heading: string;
  location: string;
  description: string;
  topImages: string[];
  bottomImages: string[];
};

const { title, name, heading, location, description, topImages, bottomImages } =
  Astro.props;
---

<Layout title={title} />
