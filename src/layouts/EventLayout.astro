---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import Layout from "./Layout.astro";

const images = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/events/*/{top,bottom}/*.{jpg,png}",
  { eager: true },
);

type Props = {
  title: string;
  name: string;
  heading: string;
  location: string;
  description: string;
  topImages: string[];
  bottomImages: string[];
};

const { title, name, heading, location, description, topImages, bottomImages } =
  Astro.props;
---

<Layout title={title}>
  <div class="px-frame flex flex-1 flex-col justify-between pt-8 pb-24">
    <div class="h-68 overflow-hidden">
      <div class="flex h-full w-max gap-3">
        {
          topImages.map((image) => (
            <Image
              alt=""
              src={images[`../assets${image}`]!.default}
              class="h-full w-auto"
            />
          ))
        }
      </div>
    </div>

    <div class="flex items-center gap-x-4">
      <h1 class="w-1/3 whitespace-pre-line">
        {`${name}\n${heading}\n${location}`}
      </h1>

      <p>{description}</p>

      <p class="ml-auto text-6xl">➤</p>
    </div>

    <div class="h-68 overflow-hidden">
      <div class="flex h-full w-max gap-3">
        {
          bottomImages.map((image) => (
            <Image
              alt=""
              src={images[`../assets${image}`]!.default}
              class="h-full w-auto"
            />
          ))
        }
      </div>
    </div>
  </div>
</Layout>
